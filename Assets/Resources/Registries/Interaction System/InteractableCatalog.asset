  archetypes:
  - archetypeId: Generator
    defaultName: Generator
    defaultDescription: Energy generator is used to power electric objects around
      it. Interact with generator to yie
    defaultState: 0
    defaultContextTags:
    - Electricity
    - Power
    - Energy
    interactionHint: 
    affordances:
    - actionName: InteractWith
      description: Interacting with generator allows to turn it if it is usable or
        fix it if it is broken
      requiredItems: []
      requiredStates: 00000000
      resultingState: 2
      consumeItems: 0
      yieldItems: []
      estimatedDuration: 500
    - actionName: Fix
      description: Interacting with generator allows to turn it on if it is usable
        or fix it if it is broken
      requiredItems:
      - itemId: Toolbox
        quantity: 1
        consumed: 1
      requiredStates: 01000000
      resultingState: 0
      consumeItems: 1
      yieldItems: []
      estimatedDuration: 500
